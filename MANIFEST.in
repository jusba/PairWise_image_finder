include README.md
include LICENSE
include CITATION.cff
include CHANGELOG.md
include config.toml
recursive-include docs *.md
recursive-include tests *.py
exclude CLAUDE.md
exclude requirements-csc.txt
prune .claude
prune .agents
prune .codex
prune backup
prune venv
prune data
prune outputs
prune panorama_images_cache
global-exclude __pycache__
global-exclude *.py[cod]
global-exclude *.npy
global-exclude *.npz
global-exclude results*.csv
